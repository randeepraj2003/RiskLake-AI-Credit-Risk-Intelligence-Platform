# RiskLake — environment variables
# Copy to .env and fill in your values
# Never commit .env to git

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=risklake
PG_USER=risklake
PG_PASSWORD=risklake

# Redis
REDIS_URL=redis://localhost:6379/0

# Gemini API (get free key at https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here

# Project root (used by Airflow DAGs and ML scripts)
RISKLAKE_ROOT=/path/to/risklake

# Frontend (used by Docker)
FRONTEND_URL=http://localhost:5173
